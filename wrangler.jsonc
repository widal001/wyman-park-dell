{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Pin compatibility settings only. The `@astrojs/cloudflare` adapter
  // generates the deployable Worker config (name, main, assets, bindings)
  // into `dist/client/wrangler.json` at build time; a plain `wrangler deploy`
  // resolves it automatically via `.wrangler/deploy/config.json` (no --config
  // flag needed). Keeping main/assets out here avoids dev (the vite plugin
  // reads this file) and build (the adapter owns the deploy config) fighting
  // over the same fields.
  "name": "wyman-park-dell",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  // Pin the SESSION KV namespace the adapter uses for Astro sessions. Without an
  // explicit id the adapter auto-provisions it, which fails once the namespace
  // exists ("already exists [code: 10014]") — e.g. on `wrangler versions upload`
  // for PR previews. Giving the existing id makes it reuse the namespace instead
  // of trying to create it.
  "kv_namespaces": [
    { "binding": "SESSION", "id": "30ca139a1f6644a7b9724d6ffcdf0345" },
  ],
}
