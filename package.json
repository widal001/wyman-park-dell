{
  "name": "fwpd-astro",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "wrangler deploy",
    "check:types": "astro check && tsc --noEmit",
    "check:lint": "eslint .",
    "check:format": "prettier --check .",
    "check:cms": "node scripts/check-cms-config.mjs",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "checks": "pnpm run check:types && pnpm run check:lint && pnpm run check:format"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.5",
    "astro": "^7.1.4",
    "marked": "^18.0.5",
    "worker-mailer": "^1.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "wrangler": "^4.114.0",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": ">=5.0.8"
    }
  }
}
