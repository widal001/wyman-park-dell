---
import type { Partner, SponsorTier } from '../../types/content';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import SmartImage from '../ui/SmartImage.astro';

// Renders a group of partner/sponsor logos as uniform, fixed-size cards.
// - The `partners` block passes a flat `partners` list → a centered grid.
// - Event sponsors pass `tiers` → left-aligned rows, one per level, each under
//   its own label. Cards are the same fixed size everywhere, so a tier with a
//   single logo looks identical to one with five (no stretching).
type Props = {
  heading: string;
  partners?: Partner[];
  tiers?: SponsorTier[];
};

const { heading, partners, tiers } = Astro.props;
const hasTiers = Boolean(tiers && tiers.length > 0);
---

<Section padding="default" background="base">
  <Container width="wide">
    {
      hasTiers ? (
        <div class="sponsors">
          <h2 class="sponsors__heading">{heading}</h2>
          <div class="sponsors__tiers">
            {(tiers ?? []).map((tier) => (
              <section class="sponsors__tier">
                <h3 class="sponsors__tier-label">{tier.tier}</h3>
                <ul role="list" class="sponsors__row">
                  {tier.partners.map((partner) => (
                    <li class="logo-card">
                      <a
                        href={partner.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="logo-card__link"
                        aria-label={partner.name}
                      >
                        <SmartImage
                          image={{
                            ...partner.logo,
                            alt: partner.logo.alt || partner.name,
                          }}
                          loading="lazy"
                          decoding="async"
                        />
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>
      ) : (
        <div class="partners">
          <header class="partners__header">
            <h2>{heading}</h2>
          </header>
          <ul role="list" class="partners__grid">
            {(partners ?? []).map((partner) => (
              <li class="logo-card">
                <a
                  href={partner.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="logo-card__link"
                  aria-label={partner.name}
                >
                  <SmartImage
                    image={{
                      ...partner.logo,
                      alt: partner.logo.alt || partner.name,
                    }}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </Container>
</Section>

<style>
  /* ---------- Shared logo card ---------- */
  /* min-width:0 stops a wide logo (Astro stamps the intrinsic width on the img)
     from blowing the card past its track/basis via flex/grid min-width:auto. */
  .logo-card {
    min-width: 0;
  }

  .logo-card__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 120px;
    padding: var(--space-4);
    background: var(--color-white);
    /* On a white section, the white-card-on-white logos need a subtle border. */
    border: 1px solid var(--color-border-base);
    border-radius: var(--radius-md);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .logo-card__link:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .logo-card__link :global(img) {
    max-width: 100%;
    max-height: 80px;
    width: auto;
    object-fit: contain;
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-card__link {
      transition: box-shadow var(--transition-fast);
    }
  }

  /* ---------- Flat `partners` block (centered grid) ---------- */
  .partners__header {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .partners__header h2 {
    font-size: var(--font-size-3xl);
    color: var(--color-brand-green-dark);
    font-weight: var(--font-weight-black);
    margin-bottom: var(--space-2);
  }

  .partners__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-6);
    align-items: center;
    justify-items: center;
  }

  /* ---------- Tiered event sponsors (left-aligned rows) ---------- */
  .sponsors__heading {
    font-size: var(--font-size-3xl);
    color: var(--color-brand-green-dark);
    font-weight: var(--font-weight-black);
    margin-bottom: var(--space-10);
  }

  .sponsors__tiers {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .sponsors__tier-label {
    font-family: var(--font-display);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-accent);
    margin-bottom: var(--space-5);
  }

  .sponsors__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  /* Fixed basis, no grow: a lone logo stays card-sized instead of stretching. */
  .sponsors__row .logo-card {
    flex: 0 0 200px;
    max-width: 200px;
  }

  @media (max-width: 480px) {
    .sponsors__row .logo-card {
      flex-basis: 100%;
      max-width: none;
    }
  }
</style>
