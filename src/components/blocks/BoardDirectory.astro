---
import type { BoardDirectoryBlock } from '../../types/content';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';

type Props = Omit<BoardDirectoryBlock, 'type'>;

const { heading, intro, members } = Astro.props;
---

<Section padding="default" paddingTop="none">
  <Container width="narrow">
    <div class="board">
      <h2 class="board__heading">{heading}</h2>
      {intro && <p class="board__intro">{intro}</p>}

      <ul role="list" class="board__list">
        {
          members.map((member) => (
            <li class="board__member">
              <span class="board__name">{member.name}</span>
              <span class="board__role">{member.role}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</Section>

<style>
  .board {
    border: 2px solid var(--color-border-base);
    border-radius: var(--radius-md);
    background: var(--color-surface-base);
    box-shadow: var(--shadow-sm);
    padding: var(--space-8);
  }

  .board__heading {
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-accent);
    line-height: var(--line-height-snug);
  }

  .board__intro {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--font-size-md);
    line-height: var(--line-height-base);
  }

  .board__list {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 2px solid var(--color-border-base);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .board__member {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    line-height: var(--line-height-snug);
  }

  .board__name {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-base);
  }

  .board__role {
    font-size: var(--font-size-base);
    font-style: italic;
    color: var(--color-text-muted);
  }
</style>
