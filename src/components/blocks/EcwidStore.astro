---
import type { EcwidStoreBlock } from '../../types/content';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';

type Props = Omit<EcwidStoreBlock, 'type'>;

const { storeId } = Astro.props;

// Ecwid requires the init script and xProductBrowser call to be inline in the
// HTML document (not executed via innerHTML) so SSR rendering handles this correctly.
const embedHtml = `
<div id="my-store-${storeId}"></div>
<script data-cfasync="false" type="text/javascript" src="https://app.ecwid.com/script.js?${storeId}&data_platform=code" charset="utf-8"></script>
<script type="text/javascript" charset="utf-8">
xProductBrowser("categoriesPerRow=3","views=grid(20,3) list(60) table(60) EmbedBasket","categoryView=grid","searchView=list","id=my-store-${storeId}");
</script>
`;
---

<Section padding="default" background="base">
  <Container width="wide">
    <Fragment set:html={embedHtml} />
  </Container>
</Section>
