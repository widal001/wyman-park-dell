---
import type { ProjectsBlock } from "../../types/content";
import Section from "../ui/Section.astro";
import Container from "../ui/Container.astro";

type Props = Omit<ProjectsBlock, "type">;

const { heading, intro, projects } = Astro.props;
---

<Section padding="default" background="raised">
  <Container width="wide">
    <div class="featured" data-featured>
      <header class="featured__header">
        <h2>{heading}</h2>
        {intro && <p>{intro}</p>}
      </header>

      <div class="featured__layout">
        <div class="featured__media-column">
          <div class="featured__media">
            {
              projects.map((project, i) => (
                <figure
                  class:list={["featured__slide", i === 0 && "is-active"]}
                  data-featured-slide={i}
                  aria-hidden={i === 0 ? "false" : "true"}
                >
                  {project.image && (
                    <img
                      src={project.image.src}
                      alt={project.image.alt || project.title}
                      width={project.image.width}
                      height={project.image.height}
                      loading={i === 0 ? "eager" : "lazy"}
                      decoding="async"
                    />
                  )}
                </figure>
              ))
            }
          </div>

          {
            projects.some((p) => p.caption) && (
              <div class="featured__caption" aria-live="polite">
                {projects.map((project, i) => (
                  <p
                    class:list={[
                      "featured__caption-text",
                      i === 0 && "is-active",
                    ]}
                    data-featured-caption={i}
                    aria-hidden={i === 0 ? "false" : "true"}
                  >
                    {project.caption}
                  </p>
                ))}
              </div>
            )
          }
        </div>

        <ul role="list" class="featured__list">
          {
            projects.map((project, i) => (
              <li class="featured__item">
                <button
                  type="button"
                  class:list={["featured__title", i === 0 && "is-active"]}
                  data-featured-tab={i}
                  aria-pressed={i === 0 ? "true" : "false"}
                >
                  {project.title}
                </button>
                <p class="featured__text">{project.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</Section>

<script>
  document.querySelectorAll<HTMLElement>("[data-featured]").forEach((root) => {
    const slides = root.querySelectorAll<HTMLElement>("[data-featured-slide]");
    const captions = root.querySelectorAll<HTMLElement>(
      "[data-featured-caption]",
    );
    const tabs = root.querySelectorAll<HTMLButtonElement>(
      "[data-featured-tab]",
    );
    if (slides.length === 0) return;

    function activate(index: number) {
      slides.forEach((slide, i) => {
        const on = i === index;
        slide.classList.toggle("is-active", on);
        slide.setAttribute("aria-hidden", on ? "false" : "true");
      });
      captions.forEach((cap, i) => {
        const on = i === index;
        cap.classList.toggle("is-active", on);
        cap.setAttribute("aria-hidden", on ? "false" : "true");
      });
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.classList.toggle("is-active", on);
        tab.setAttribute("aria-pressed", on ? "true" : "false");
      });
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => activate(i));
    });
  });
</script>

<style>
  .featured__header {
    text-align: center;
    margin-bottom: var(--space-10);
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  .featured__header h2 {
    font-size: var(--font-size-3xl);
    color: var(--color-brand-green-dark);
    font-weight: var(--font-weight-black);
    line-height: var(--line-height-tight);
    margin-bottom: var(--space-3);
  }

  .featured__header p {
    color: var(--color-text-base);
    line-height: var(--line-height-base);
  }

  .featured__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: stretch;
  }

  .featured__media-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .featured__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-neutral-100);
    flex: 1;
    min-height: 360px;
  }

  .featured__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity var(--transition-base);
    pointer-events: none;
  }

  .featured__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .featured__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  .featured__caption {
    position: relative;
    min-height: 1.5em;
  }

  .featured__caption-text {
    position: absolute;
    inset: 0;
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: var(--line-height-snug);
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .featured__caption-text.is-active {
    opacity: 1;
  }

  .featured__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .featured__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .featured__title {
    align-self: flex-start;
    padding: 0 0 var(--space-1);
    font-family: var(--font-display);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-brand-green-dark);
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: border-color var(--transition-fast);
  }

  .featured__title:hover,
  .featured__title:focus-visible,
  .featured__title.is-active {
    border-bottom-color: var(--color-brand-orange);
  }

  .featured__text {
    color: var(--color-text-base);
    line-height: var(--line-height-base);
  }

  @media (max-width: 900px) {
    .featured__layout {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
