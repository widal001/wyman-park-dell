---
import type { TwoColumnTextBlock } from '../../types/content';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import GhostLink from '../ui/GhostLink.astro';

type Props = Omit<TwoColumnTextBlock, 'type'>;

const {
  leftHeading,
  leftHtml,
  leftCtas = [],
  rightHeading,
  rightHtml,
  rightCtas,
  ctas,
  background = 'base',
  alignAcross = true,
  paddingTop,
  paddingBottom,
} = Astro.props;

// Right-column CTAs: prefer explicit `rightCtas`, fall back to legacy `ctas`.
const resolvedRightCtas = rightCtas ?? ctas ?? [];
const hasHeadingRow = Boolean(leftHeading || rightHeading);
const hasCtaRow = leftCtas.length > 0 || resolvedRightCtas.length > 0;
---

<Section
  padding="small"
  paddingTop={paddingTop}
  paddingBottom={paddingBottom}
  background={background}
>
  <Container width="wide">
    <div
      class:list={[
        'two-col',
        alignAcross ? 'two-col--aligned' : 'two-col--independent',
        hasHeadingRow && 'two-col--has-heading',
        hasCtaRow && 'two-col--has-cta',
      ]}
    >
      {
        alignAcross ? (
          <>
            {hasHeadingRow && (
              <>
                <h2 class="two-col__heading two-col__heading--left">
                  {leftHeading}
                </h2>
                <h2 class="two-col__heading two-col__heading--right">
                  {rightHeading}
                </h2>
              </>
            )}

            <div
              class="two-col__body two-col__body--left prose"
              set:html={leftHtml}
            />
            <div
              class="two-col__body two-col__body--right prose"
              set:html={rightHtml}
            />

            {hasCtaRow && (
              <>
                <ul role="list" class="two-col__ctas two-col__ctas--left">
                  {leftCtas.map((cta) => (
                    <li>
                      <GhostLink {...cta} />
                    </li>
                  ))}
                </ul>
                <ul role="list" class="two-col__ctas two-col__ctas--right">
                  {resolvedRightCtas.map((cta) => (
                    <li>
                      <GhostLink {...cta} />
                    </li>
                  ))}
                </ul>
              </>
            )}
          </>
        ) : (
          <>
            <div class="two-col__column">
              {leftHeading && <h2 class="two-col__heading">{leftHeading}</h2>}
              <div class="prose" set:html={leftHtml} />
              {leftCtas.length > 0 && (
                <ul role="list" class="two-col__ctas">
                  {leftCtas.map((cta) => (
                    <li>
                      <GhostLink {...cta} />
                    </li>
                  ))}
                </ul>
              )}
            </div>
            <div class="two-col__column">
              {rightHeading && <h2 class="two-col__heading">{rightHeading}</h2>}
              <div class="prose" set:html={rightHtml} />
              {resolvedRightCtas.length > 0 && (
                <ul role="list" class="two-col__ctas">
                  {resolvedRightCtas.map((cta) => (
                    <li>
                      <GhostLink {...cta} />
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </>
        )
      }
    </div>
  </Container>
</Section>

<style>
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--space-10);
  }

  /* === Aligned variant: shared grid rows so headings, bodies, and CTAs line up across columns. ===
     Grid placements are scoped to desktop so they don't conflict with the mobile single-column flow. */
  .two-col--aligned .two-col__ctas--left,
  .two-col--aligned .two-col__ctas--right {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @media (min-width: 769px) {
    .two-col--aligned {
      grid-template-rows: 1fr;
      row-gap: var(--space-2);
    }

    .two-col--aligned.two-col--has-heading {
      grid-template-rows: auto 1fr;
    }

    .two-col--aligned.two-col--has-cta {
      grid-template-rows: 1fr auto;
    }

    .two-col--aligned.two-col--has-heading.two-col--has-cta {
      grid-template-rows: auto 1fr auto;
    }

    .two-col--aligned .two-col__heading--left {
      grid-column: 1;
      grid-row: 1;
    }
    .two-col--aligned .two-col__heading--right {
      grid-column: 2;
      grid-row: 1;
    }

    .two-col--aligned .two-col__body--left {
      grid-column: 1;
    }
    .two-col--aligned .two-col__body--right {
      grid-column: 2;
    }

    .two-col--aligned.two-col--has-heading .two-col__body--left,
    .two-col--aligned.two-col--has-heading .two-col__body--right {
      grid-row: 2;
    }

    .two-col--aligned:not(.two-col--has-heading) .two-col__body--left,
    .two-col--aligned:not(.two-col--has-heading) .two-col__body--right {
      grid-row: 1;
    }

    .two-col--aligned .two-col__ctas--left {
      grid-column: 1;
    }
    .two-col--aligned .two-col__ctas--right {
      grid-column: 2;
    }

    .two-col--aligned.two-col--has-heading.two-col--has-cta
      .two-col__ctas--left,
    .two-col--aligned.two-col--has-heading.two-col--has-cta
      .two-col__ctas--right {
      grid-row: 3;
    }

    .two-col--aligned:not(.two-col--has-heading).two-col--has-cta
      .two-col__ctas--left,
    .two-col--aligned:not(.two-col--has-heading).two-col--has-cta
      .two-col__ctas--right {
      grid-row: 2;
    }
  }

  /* === Independent variant: each column flows its own content top-to-bottom === */
  .two-col--independent .two-col__column {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .two-col--independent .two-col__column .two-col__ctas {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  /* === Shared typography === */
  .two-col__heading {
    font-size: var(--font-size-3xl);
    color: var(--color-brand-green-dark);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    margin: 0;
  }

  .two-col__body {
    line-height: var(--line-height-base);
  }

  @media (max-width: 768px) {
    .two-col {
      grid-template-columns: 1fr;
      row-gap: var(--space-6);
    }

    /* Mobile stack order: left column first, then right column. */
    .two-col--aligned .two-col__heading--left {
      order: 1;
    }
    .two-col--aligned .two-col__body--left {
      order: 2;
    }
    .two-col--aligned .two-col__ctas--left {
      order: 3;
    }
    .two-col--aligned .two-col__heading--right {
      order: 4;
    }
    .two-col--aligned .two-col__body--right {
      order: 5;
    }
    .two-col--aligned .two-col__ctas--right {
      order: 6;
    }
  }
</style>
