---
import type { FollowUsBlock } from '../../types/content';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import SocialLinks from '../layout/SocialLinks.astro';
import { site } from '../../content/site';

type Props = Omit<FollowUsBlock, 'type'>;

const {
  heading = `Follow ${site.name}`,
  background = 'raised',
  paddingTop,
  paddingBottom,
} = Astro.props;
---

<Section
  padding="default"
  paddingTop={paddingTop}
  paddingBottom={paddingBottom}
  background={background}
>
  <Container width="wide">
    <div class="follow-us">
      <h2 class="follow-us__heading">{heading}</h2>
      <div class="follow-us__social">
        <SocialLinks links={site.social} variant="pills" />
      </div>
    </div>
  </Container>
</Section>

<style>
  .follow-us {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    text-align: center;
  }

  .follow-us__heading {
    font-size: var(--font-size-3xl);
    color: var(--color-brand-green-dark);
    font-weight: var(--font-weight-black);
    line-height: var(--line-height-tight);
  }

  .follow-us__social :global(.social) {
    gap: var(--space-4);
  }

  .follow-us__social :global(.social--pills .social__link) {
    width: 56px;
    height: 56px;
  }

  .follow-us__social :global(.social--pills .social__link svg) {
    width: 28px;
    height: 28px;
  }
</style>
