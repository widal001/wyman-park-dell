---
type Props = {
  width?: 'wide' | 'medium' | 'narrow' | 'full';
  as?: keyof HTMLElementTagNameMap;
  class?: string;
};

const { width = 'wide', as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['container', `container--${width}`, className]}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--container-padding-x);
  }

  .container--wide {
    max-width: var(--container-max);
  }

  .container--medium {
    max-width: var(--container-medium);
  }

  .container--narrow {
    max-width: var(--container-narrow);
  }

  .container--full {
    max-width: none;
    padding-inline: 0;
  }
</style>
