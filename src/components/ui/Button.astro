---
import type { CtaRef } from '../../types/content';

type Props = CtaRef & {
  size?: 'md' | 'lg';
  class?: string;
};

const {
  label,
  href,
  variant = 'primary',
  external = false,
  size = 'md',
  class: className,
} = Astro.props;

const target = external ? '_blank' : undefined;
const rel = external ? 'noopener noreferrer' : undefined;
---

<a
  href={href}
  target={target}
  rel={rel}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
>
  {label}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    border-radius: var(--radius-sm);
    border: 2px solid transparent;
    transition:
      background-color var(--transition-base),
      color var(--transition-base),
      border-color var(--transition-base),
      transform var(--transition-fast);
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .btn:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  .btn--md {
    font-size: var(--font-size-sm);
    padding: var(--space-3) var(--space-6);
  }

  .btn--lg {
    font-size: var(--font-size-md);
    padding: var(--space-4) var(--space-8);
  }

  .btn--primary {
    background: var(--color-brand-orange-light);
    color: var(--color-brand-green-dark);
    border-color: var(--color-brand-orange-light);
  }

  .btn--primary:hover {
    background: var(--color-white);
    border-color: var(--color-brand-orange-light);
    color: var(--color-brand-green-dark);
  }

  /* Outline-inverse: transparent with white border + white text — for dark backgrounds (e.g. hero overlays).
     Hover preserves identity; only motion + a faint white wash signal interactivity. */
  .btn--outline-inverse {
    background: transparent;
    color: var(--color-white);
    border-color: var(--color-white);
  }

  .btn--outline-inverse:hover {
    background: rgba(255, 255, 255, 0.12);
    color: var(--color-white);
    border-color: var(--color-white);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
  }

  /* Solid-inverse: white fill with dark green text. Hover keeps the same fill, only lifts + adds shadow. */
  .btn--solid-inverse {
    background: var(--color-white);
    color: var(--color-brand-green-dark);
    border-color: var(--color-white);
  }

  .btn--solid-inverse:hover {
    background: var(--color-white);
    color: var(--color-brand-green-dark);
    border-color: var(--color-white);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-text-accent);
    border-color: transparent;
    border-radius: 0;
    padding-inline: 0;
    transition: border-color var(--transition-fast);
  }

  .btn--ghost:hover,
  .btn--ghost:focus-visible {
    color: var(--color-text-accent);
    border-bottom-color: var(--color-brand-orange);
  }

  .btn--outline {
    background: transparent;
    color: var(--color-brand-green-dark);
    border-color: var(--color-brand-orange);
  }

  .btn--outline:hover {
    background: var(--color-brand-orange-light);
    color: var(--color-brand-green-dark);
    border-color: var(--color-brand-orange-light);
  }
</style>
