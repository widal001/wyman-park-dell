---
import type { NewsletterConfig } from '../../types/content';

type Props = {
  config: NewsletterConfig;
};

const { config } = Astro.props;
const action = config.action || '#';
---

<form
  class="newsletter"
  action={action}
  method={config.method ?? 'POST'}
  data-newsletter-form
>
  <h2 class="newsletter__heading">{config.heading}</h2>

  {config.hiddenFields?.map((field) => (
    <input type="hidden" name={field.name} value={field.value} />
  ))}

  <label class="newsletter__field">
    <span class="visually-hidden">{config.fields.name.label}</span>
    <input
      type="text"
      name={config.fields.name.name}
      placeholder={config.fields.name.placeholder}
      autocomplete="name"
    />
  </label>

  <label class="newsletter__field">
    <span class="visually-hidden">{config.fields.email.label}</span>
    <input
      type="email"
      name={config.fields.email.name}
      placeholder={config.fields.email.placeholder}
      autocomplete="email"
      required
    />
  </label>

  <button type="submit" class="newsletter__submit">
    {config.submitLabel}
  </button>
</form>

<style>
  .newsletter {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
  }

  .newsletter__heading {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-white);
    margin-bottom: var(--space-2);
  }

  .newsletter__field input {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: var(--color-white);
    color: var(--color-brand-green-dark);
    border: 1px solid var(--color-white);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-md);
    line-height: var(--line-height-snug);
  }

  .newsletter__field input::placeholder {
    color: var(--color-neutral-500);
  }

  .newsletter__field input:focus-visible {
    outline: 3px solid var(--color-brand-green-dark);
    outline-offset: 2px;
  }

  .newsletter__submit {
    margin-top: var(--space-1);
    padding: var(--space-3) var(--space-4);
    background: transparent;
    color: var(--color-white);
    border: 2px solid var(--color-white);
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    cursor: pointer;
    transition: background-color var(--transition-fast),
                color var(--transition-fast);
  }

  .newsletter__submit:hover {
    background: var(--color-white);
    color: var(--color-brand-green-dark);
  }

  .newsletter__submit:focus-visible {
    outline: 3px solid var(--color-brand-green-dark);
    outline-offset: 3px;
  }
</style>
