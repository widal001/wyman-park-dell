---
import type { SocialLink } from "../../types/content";

type Props = {
  links: SocialLink[];
  variant?: "pills" | "plain" | "plain-inverse";
};

const { links, variant = "pills" } = Astro.props;

const ICONS: Record<SocialLink["network"], string> = {
