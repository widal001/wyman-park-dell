---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import MainNav from './MainNav.astro';
import MobileMenu from './MobileMenu.astro';
import { site } from '../../content/site';
---

<header class="site-header">
  <Container width="wide">
    <div class="site-header__inner">
      <a href="/" class="site-header__brand" aria-label={`${site.name} home`}>
        <img
          src={site.logo.src}
          alt={site.logo.alt}
          width={site.logo.width}
          height={site.logo.height}
          loading="eager"
          decoding="sync"
        />
      </a>

      <div class="site-header__desktop">
        <MainNav items={site.primaryNav} ariaLabel="Main" />
        <Button {...site.donateCta} class="site-header__cta" />
      </div>

      <MobileMenu items={site.primaryNav} donateCta={site.donateCta} />
    </div>
  </Container>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--color-surface-base);
    border-bottom: 1px solid var(--color-border-base);
    box-shadow: var(--shadow-sm);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .site-header__brand img {
    height: 64px;
    width: auto;
    border-radius: var(--radius-pill);
  }

  .site-header__desktop {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: nowrap;
    justify-content: flex-end;
    flex: 1;
    min-width: 0;
  }

  .site-header__cta {
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .site-header__desktop {
      display: none;
    }

    .site-header__brand img {
      height: 48px;
    }
  }
</style>
