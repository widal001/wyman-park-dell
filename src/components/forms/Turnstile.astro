---
/**
 * Cloudflare Turnstile widget slot.
 *
 * Turnstile is PRESENCE-GATED: the slot only renders when a site key is set via
 * PUBLIC_TURNSTILE_SITE_KEY. With no key (the default), no widget renders, no
 * script loads, and forms fall back to honeypot + timing protection. Set the key
 * (real or Cloudflare's `1x00000000000000000000AA` test key) to switch it on —
 * the client renders it and the server enforces it, no code changes needed.
 *
 * The slot itself is only a placeholder; forms-client.ts injects the widget's
 * api.js lazily on first form interaction, so it costs nothing until engaged.
 */
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

{siteKey && <div class="cf-turnstile-slot" data-sitekey={siteKey} />}

<style is:global>
  .cf-turnstile-slot:not(:empty) {
    margin-block: var(--space-3);
  }

  /* Inline status message shared by all forms. */
  .form-status {
    margin: 0;
    font-size: var(--font-size-sm);
    min-height: 1.25em;
  }
  .form-status[data-state='error'] {
    color: var(--color-error, #b3261e);
  }
  .form-status[data-state='success'] {
    color: var(--color-brand-green-dark);
    font-weight: var(--font-weight-bold);
  }

  /* Transient success state applied to any form's submit button on success. */
  button.is-success {
    background: var(--color-brand-green-dark) !important;
    border-color: var(--color-brand-green-dark) !important;
    color: var(--color-white) !important;
    cursor: default;
  }
</style>
