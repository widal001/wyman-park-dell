---
// Detail page for every entry in the events collection. The events block cards
// (src/components/blocks/Events.astro) link here via `/events/{slug}`.
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import SmartImage from '../../components/ui/SmartImage.astro';
import PartnerLogos from '../../components/blocks/PartnerLogos.astro';
import { eventSlug, resolveEventDate, todayYmd } from '../../lib/events';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { slug: eventSlug(event) },
    props: { event },
  }));
}

const { event } = Astro.props as { event: CollectionEntry<'events'> };
const data = event.data;

marked.setOptions({ async: false });
const detailsHtml = data.details ? (marked.parse(data.details) as string) : '';

// Recurring events (e.g. the monthly clean-up) display their next occurrence.
const from = todayYmd();
const startYmd = resolveEventDate(event, from);
const endYmd = data.endDate;

const weekdayFmt = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  timeZone: 'UTC',
});
const longDateFmt = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
const monthDayFmt = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const weekdayDateFmt = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

function parseISODate(value: string): Date {
  return new Date(`${value}T00:00:00Z`);
}

const start = parseISODate(startYmd);
const end = endYmd ? parseISODate(endYmd) : null;
const datetimeAttr = end ? `${startYmd}/${endYmd}` : startYmd;

// One-line date summary for the hero. Multi-day events read as a range; a
// single day leads with its weekday.
const dateSummary = end
  ? `${monthDayFmt.format(start)} – ${longDateFmt.format(end)}`
  : `${weekdayFmt.format(start)}, ${longDateFmt.format(start)}`;

// The details-card date line: weekday label on top, full date below.
const datePrimary = end
  ? `${monthDayFmt.format(start)} – ${monthDayFmt.format(end)}`
  : weekdayFmt.format(start);
const dateSecondary = end ? longDateFmt.format(end) : longDateFmt.format(start);

// Group schedule items by day, preserving authored order within each day.
type ScheduleItem = NonNullable<typeof data.schedule>[number];
const scheduleByDay = (data.schedule ?? []).reduce<Map<string, ScheduleItem[]>>(
  (acc, item) => {
    const list = acc.get(item.date) ?? [];
    list.push(item);
    acc.set(item.date, list);
    return acc;
  },
  new Map(),
);

const metaDescription = data.description;
---

<BaseLayout
  title={data.title}
  description={metaDescription}
  ogImage={data.image?.src}
>
  <!-- Hero band: image + green overlay, matching the site's standard hero. -->
  <section class="event-hero">
    {
      data.image && (
        <div class="event-hero__media">
          <SmartImage
            image={data.image}
            loading="eager"
            decoding="sync"
            fetchpriority="high"
            sizes="100vw"
            widths={[640, 960, 1280, 1920]}
          />
        </div>
      )
    }
    <div class="event-hero__overlay" aria-hidden="true"></div>

    <Container width="wide">
      <div class="event-hero__content">
        <a class="event-hero__back" href="/events">← All events</a>
        <h1 class="event-hero__title">{data.title}</h1>
        <p class="event-hero__date">
          <time datetime={datetimeAttr}>{dateSummary}</time>
          {data.location && <span> · {data.location}</span>}
        </p>
      </div>
    </Container>
  </section>

  <Section padding="default" background="base">
    <Container width="medium">
      <div class="event-layout">
        <div class="event-main">
          <p class="event-lead">{data.description}</p>
          {detailsHtml && <div class="event-body" set:html={detailsHtml} />}
        </div>

        <aside class="event-aside" aria-label="Event details">
          <div class="facts">
            <h2 class="facts__title">Details</h2>
            <ul class="facts__list" role="list">
              <li class="facts__row">
                <span class="facts__icon" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    width="20"
                    height="20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect x="3" y="4" width="18" height="17" rx="2"></rect>
                    <path d="M3 9h18M8 2v4M16 2v4"></path>
                  </svg>
                </span>
                <span class="facts__text">
                  <span class="facts__label">When</span>
                  <span class="facts__value">{datePrimary}</span>
                  <span class="facts__sub">{dateSecondary}</span>
                </span>
              </li>

              {
                data.time && (
                  <li class="facts__row">
                    <span class="facts__icon" aria-hidden="true">
                      <svg
                        viewBox="0 0 24 24"
                        width="20"
                        height="20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 7v5l3 2" />
                      </svg>
                    </span>
                    <span class="facts__text">
                      <span class="facts__label">Time</span>
                      <span class="facts__value">{data.time}</span>
                    </span>
                  </li>
                )
              }

              {
                data.location && (
                  <li class="facts__row">
                    <span class="facts__icon" aria-hidden="true">
                      <svg
                        viewBox="0 0 24 24"
                        width="20"
                        height="20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M12 21s-7-5.686-7-11a7 7 0 0 1 14 0c0 5.314-7 11-7 11z" />
                        <circle cx="12" cy="10" r="2.5" />
                      </svg>
                    </span>
                    <span class="facts__text">
                      <span class="facts__label">Where</span>
                      <span class="facts__value">{data.location}</span>
                    </span>
                  </li>
                )
              }

              {
                data.recurrence && (
                  <li class="facts__row">
                    <span class="facts__icon" aria-hidden="true">
                      <svg
                        viewBox="0 0 24 24"
                        width="20"
                        height="20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M17 2l4 4-4 4" />
                        <path d="M3 11V9a4 4 0 0 1 4-4h14" />
                        <path d="M7 22l-4-4 4-4" />
                        <path d="M21 13v2a4 4 0 0 1-4 4H3" />
                      </svg>
                    </span>
                    <span class="facts__text">
                      <span class="facts__label">Repeats</span>
                      <span class="facts__value">{data.recurrence.label}</span>
                    </span>
                  </li>
                )
              }
            </ul>
          </div>
        </aside>
      </div>
    </Container>
  </Section>

  {
    scheduleByDay.size > 0 && (
      <Section padding="default" background="raised">
        <Container width="medium">
          <h2 class="event-section-heading">Schedule of activities</h2>
          <ol class="schedule" role="list">
            {Array.from(scheduleByDay.entries()).map(([date, items]) => (
              <li class="schedule__day">
                <h3 class="schedule__date">
                  {weekdayDateFmt.format(parseISODate(date))}
                </h3>
                <ul class="schedule__items" role="list">
                  {items.map((item) => (
                    <li
                      class:list={[
                        'schedule__item',
                        item.image && 'schedule__item--media',
                      ]}
                    >
                      <span class="schedule__time">
                        {item.time ?? 'All day'}
                      </span>
                      <div class="schedule__detail">
                        <h4 class="schedule__item-title">{item.title}</h4>
                        {item.description && <p>{item.description}</p>}
                        {item.cta && (
                          <a
                            class="schedule__link"
                            href={item.cta.href}
                            target={item.cta.external ? '_blank' : undefined}
                            rel={
                              item.cta.external
                                ? 'noopener noreferrer'
                                : undefined
                            }
                          >
                            {item.cta.label}
                            <span
                              class="schedule__link-arrow"
                              aria-hidden="true"
                            >
                              →
                            </span>
                          </a>
                        )}
                      </div>
                      {item.image && (
                        <div class="schedule__media">
                          <SmartImage
                            image={item.image}
                            loading="lazy"
                            decoding="async"
                            sizes="(min-width: 900px) 210px, 100vw"
                            widths={[210, 420, 630]}
                          />
                        </div>
                      )}
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        </Container>
      </Section>
    )
  }

  {
    data.sponsorTiers && data.sponsorTiers.length > 0 && (
      <PartnerLogos
        heading="Thank you to our sponsors"
        tiers={data.sponsorTiers}
      />
    )
  }
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .event-hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 420px;
    padding-block: var(--space-12);
    background: var(--color-brand-green-dark);
    color: var(--color-text-inverse);
    overflow: hidden;
  }

  .event-hero__media,
  .event-hero__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .event-hero__media {
    z-index: 0;
  }

  .event-hero__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Near-black, bottom-weighted scrim so the bottom-aligned title/date clear
     WCAG AA contrast (≥3:1 large text) even over a bright photo. The floor near
     the text is ~0.85, dark enough to hold white on any image. */
  .event-hero__overlay {
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.45) 0%,
      rgba(0, 0, 0, 0.6) 40%,
      rgba(0, 0, 0, 0.85) 100%
    );
  }

  .event-hero :global(.container) {
    position: relative;
    z-index: 2;
    grid-area: 1 / 1;
    width: 100%;
  }

  .event-hero__content {
    max-width: 60ch;
  }

  .event-hero__back {
    display: inline-block;
    margin-bottom: var(--space-5);
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-white);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: border-color var(--transition-fast);
  }

  .event-hero__back:hover,
  .event-hero__back:focus-visible {
    border-bottom-color: var(--color-brand-orange);
  }

  .event-hero__title {
    color: var(--color-white);
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-black);
    line-height: var(--line-height-tight);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }

  .event-hero__date {
    margin-top: var(--space-4);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-white);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }

  @media (max-width: 768px) {
    .event-hero {
      min-height: 340px;
    }

    .event-hero__title {
      font-size: var(--font-size-3xl);
    }
  }

  /* ---------- Body layout ---------- */
  .event-layout {
    display: grid;
    gap: var(--space-10);
    align-items: start;
  }

  @media (min-width: 900px) {
    .event-layout {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: var(--space-12);
    }
  }

  .event-lead {
    font-size: var(--font-size-lg);
    line-height: var(--line-height-base);
    color: var(--color-text-base);
    font-weight: var(--font-weight-bold);
  }

  .event-body {
    margin-top: var(--space-6);
    font-size: var(--font-size-md);
    line-height: var(--line-height-base);
  }

  .event-body :global(p) {
    margin-bottom: var(--space-4);
  }

  .event-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .event-body :global(h2),
  .event-body :global(h3) {
    color: var(--color-brand-green-dark);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .event-body :global(a) {
    color: var(--color-text-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .event-body :global(ul),
  .event-body :global(ol) {
    margin: 0 0 var(--space-4) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .event-body :global(li) {
    list-style: disc;
  }

  /* ---------- Details / facts card ---------- */
  .facts {
    border: 2px solid var(--color-brand-green);
    border-radius: var(--radius-md);
    background: var(--color-surface-base);
    box-shadow: var(--shadow-sm);
    padding: var(--space-6);
  }

  @media (min-width: 900px) {
    .facts {
      position: sticky;
      top: var(--space-8);
    }
  }

  .facts__title {
    font-family: var(--font-display);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-accent);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-4);
    border-bottom: 2px solid var(--color-border-base);
  }

  .facts__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .facts__row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
  }

  .facts__icon {
    display: inline-flex;
    color: var(--color-brand-green);
    margin-top: 2px;
  }

  .facts__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .facts__label {
    font-family: var(--font-display);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-muted);
  }

  .facts__value {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-brand-green-dark);
    line-height: var(--line-height-snug);
  }

  .facts__sub {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  /* ---------- Schedule ---------- */
  .event-section-heading {
    font-size: var(--font-size-3xl);
    color: var(--color-brand-green-dark);
    font-weight: var(--font-weight-black);
    margin-bottom: var(--space-8);
  }

  .schedule {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .schedule__date {
    font-size: var(--font-size-xl);
    color: var(--color-brand-green-dark);
    font-weight: var(--font-weight-bold);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-4);
    border-bottom: 2px solid var(--color-brand-green);
  }

  .schedule__items {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .schedule__item {
    display: grid;
    grid-template-columns: minmax(0, 8rem) 1fr;
    gap: var(--space-5);
    padding: var(--space-5);
    background: var(--color-surface-base);
    border: 2px solid var(--color-brand-green);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  /* Activities with a photo add a flush, full-height media panel on the right.
     The panel bleeds past the card padding to the inner border on three sides;
     the column gap keeps a clean gutter on the text side. */
  .schedule__item--media {
    grid-template-columns: minmax(0, 8rem) minmax(0, 1fr) 210px;
  }

  .schedule__item--media .schedule__media {
    align-self: stretch;
    margin: calc(-1 * var(--space-5)) calc(-1 * var(--space-5))
      calc(-1 * var(--space-5)) 0;
  }

  .schedule__item--media .schedule__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .schedule__item:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .schedule__time {
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-accent);
  }

  .schedule__detail {
    min-width: 0;
  }

  .schedule__item-title {
    font-size: var(--font-size-lg);
    color: var(--color-brand-green-dark);
    line-height: var(--line-height-snug);
    margin-bottom: var(--space-1);
  }

  .schedule__detail p {
    font-size: var(--font-size-base);
    line-height: var(--line-height-base);
    color: var(--color-text-muted);
  }

  /* Activity CTA — a light arrow link that reads as part of the activity
     rather than a floating button. The arrow slides on hover. */
  .schedule__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-accent);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    padding-bottom: 2px;
    transition:
      border-color var(--transition-fast),
      gap var(--transition-fast);
  }

  .schedule__link:hover,
  .schedule__link:focus-visible {
    border-bottom-color: var(--color-brand-orange);
    gap: var(--space-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .schedule__link {
      transition: border-color var(--transition-fast);
    }
  }

  /* Stack the media panel below the text on narrow screens: full width,
     bleeding to the card's bottom and sides. */
  @media (max-width: 640px) {
    .schedule__item--media {
      grid-template-columns: 1fr;
    }

    .schedule__item--media .schedule__media {
      margin: var(--space-4) calc(-1 * var(--space-5)) calc(-1 * var(--space-5));
    }

    .schedule__item--media .schedule__media :global(img) {
      height: 220px;
    }
  }

  @media (max-width: 560px) {
    .schedule__item {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
