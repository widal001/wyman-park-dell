---
// Single route for every entry in the `pages` collection. Each page's `slug`
// field becomes its URL ("" => homepage), so adding a page in the CMS produces
// a new URL with no code change. Dedicated static routes (contact, events,
// friends-of-wyman-park-dell) take priority over this one.
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { renderBlocks } from '../lib/blocks';
import type { EventItem } from '../types/content';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({
    params: { slug: page.data.slug || undefined },
    props: { page },
  }));
}

const { page } = Astro.props as { page: CollectionEntry<'pages'> };

// Events live in their own collection. Each `events` block's `limit` caps how
// many it shows; renderBlocks handles the injection and only touches the events
// block type. Here we resolve recurring events to their next occurrence, drop
// events already past, and sort soonest-first so "upcoming" is truly upcoming.
const now = new Date();
const todayYmd = [
  now.getFullYear(),
  String(now.getMonth() + 1).padStart(2, '0'),
  String(now.getDate()).padStart(2, '0'),
].join('-');

/** Date (UTC) of the `week`-th `weekday` in a given month. */
function nthWeekdayOfMonth(
  year: number,
  monthIdx: number,
  week: number,
  weekday: number,
): Date {
  const first = new Date(Date.UTC(year, monthIdx, 1));
  const shift = (weekday - first.getUTCDay() + 7) % 7;
  return new Date(Date.UTC(year, monthIdx, 1 + shift + (week - 1) * 7));
}

/** Next occurrence (YYYY-MM-DD) of a monthly Nth-weekday rule on/after `fromYmd`. */
function nextRecurrenceDate(
  rec: { weekday: number; week: number },
  fromYmd: string,
): string {
  const from = new Date(`${fromYmd}T00:00:00Z`);
  let year = from.getUTCFullYear();
  let month = from.getUTCMonth();
  for (let i = 0; i < 24; i++) {
    const d = nthWeekdayOfMonth(year, month, rec.week, rec.weekday);
    if (d.getTime() >= from.getTime()) return d.toISOString().slice(0, 10);
    month += 1;
    if (month > 11) {
      month = 0;
      year += 1;
    }
  }
  return fromYmd;
}

const eventEntries = await getCollection('events');
const events: EventItem[] = eventEntries
  .map((e) => {
    const rec = e.data.recurrence;
    const date = rec ? nextRecurrenceDate(rec, todayYmd) : e.data.date;
    return {
      title: e.data.title,
      date,
      endDate: e.data.endDate,
      time: e.data.time,
      location: e.data.location,
      body: e.data.description,
      image: e.data.image,
      cta: e.data.cta,
      recurrence: rec?.label,
    };
  })
  .filter((e) => (e.endDate ?? e.date) >= todayYmd)
  .sort((a, b) => a.date.localeCompare(b.date));

const blocks = renderBlocks(page.data.blocks, { events });
---

<BaseLayout title={page.data.title} description={page.data.metaDescription}>
  <BlockRenderer blocks={blocks} />
</BaseLayout>
