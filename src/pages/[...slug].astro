---
// Single route for every entry in the `pages` collection. Each page's `slug`
// field becomes its URL ("" => homepage), so adding a page in the CMS produces
// a new URL with no code change. Dedicated static routes (contact, events,
// friends-of-wyman-park-dell) take priority over this one.
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { renderBlocks } from '../lib/blocks';
import { getEventsForDisplay } from '../lib/events';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({
    params: { slug: page.data.slug || undefined },
    props: { page },
  }));
}

const { page } = Astro.props as { page: CollectionEntry<'pages'> };

// Events live in their own collection; renderBlocks injects them and only
// touches the events block type. getEventsForDisplay returns everything
// upcoming as of this build, soonest first, with recurring events expanded to
// their next several dates — the events block renders the lot and the browser
// picks today's slice, so the list stays current between deploys.
const events = await getEventsForDisplay();

const blocks = renderBlocks(page.data.blocks, { events });
---

<BaseLayout title={page.data.title} description={page.data.metaDescription}>
  <BlockRenderer blocks={blocks} />
</BaseLayout>
